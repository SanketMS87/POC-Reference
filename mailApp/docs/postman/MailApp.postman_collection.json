{
  "info": {
    "name": "Mail Application API",
    "description": "Requests for the mailApp Spring Boot service (context path /mail, default port 9080).\n\nSetup:\n1. Import MailApp.local.postman_environment.json (or the train1 one) and select it.\n2. For non-local environments run '00 Auth / Get Entra ID token' first; it stores the token in {{accessToken}}.\n3. The 'local' profile is permit-all, so no token is needed there.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 Auth",
      "item": [
        {
          "name": "Get Entra ID token (client credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token endpoint returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response has access_token', function () {",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.environment.set('accessToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{mailAppScope}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{tokenUrl}}",
              "host": [
                "{{tokenUrl}}"
              ]
            },
            "description": "Obtains a bearer token for calling the Mail App. The token's audience must match app.security.jwt.audiences and the roles claim must contain a role accepted by @PreAuthorize."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body confirms app is working', function () {",
                  "    pm.expect(pm.response.text()).to.include('Mail Application Working');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Public liveness check."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Mail Notifications",
      "item": [
        {
          "name": "Send policy mail (deal + policy + template)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time under 60s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/initiate/{{dealNum}}/{{policyNum}}/{{policyTemplateName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "initiate",
                "{{dealNum}}",
                "{{policyNum}}",
                "{{policyTemplateName}}"
              ]
            },
            "description": "Fetches the deal (UWB) and policy (POM), then mails the underwriter (TO) and UW assistant (CC) subject to T_NOTIFICATION_PREFERENCES (attribute 10580). Requires any role in allUserRoles."
          },
          "response": []
        },
        {
          "name": "Send decline mail (deal or policy + template)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/initiate/{{dealNum}}/{{declineTemplateName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "initiate",
                "{{dealNum}}",
                "{{declineTemplateName}}"
              ]
            },
            "description": "Fetches the deal (UWB) and sends the decline mail (attribute 10581). Requires a role in allUserRolesWithReadWrite."
          },
          "response": []
        },
        {
          "name": "Send generic email (UW_AUTHORITY_SELF_DECLARATION)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealNumber\": \"{{dealNum}}\",\n  \"templateName\": \"UW_AUTHORITY_SELF_DECLARATION\",\n  \"assigneeUserId\": \"{{assigneeUserId}}\",\n  \"documentName\": \"{{documentName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sendEmail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sendEmail"
              ]
            },
            "description": "Generic dispatch. Sends to the assignee only (no CC) and bypasses notification preferences. Requires a role in allUserRolesWithReadWrite."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Negative Tests",
      "item": [
        {
          "name": "sendEmail - missing required fields (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('ErrorResponse lists validation details', function () {",
                  "    pm.expect(body.status).to.eql(400);",
                  "    pm.expect(body.details).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentName\": \"only-optional-field\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sendEmail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sendEmail"
              ]
            },
            "description": "dealNumber, templateName and assigneeUserId are @NotBlank."
          },
          "response": []
        },
        {
          "name": "sendEmail - malformed JSON (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Message mentions malformed JSON', function () {",
                  "    pm.expect(pm.response.json().message).to.include('Malformed JSON');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"dealNumber\": ",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sendEmail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sendEmail"
              ]
            }
          },
          "response": []
        },
        {
          "name": "sendEmail - unsupported template (500)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 500', function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test('Message mentions unsupported template', function () {",
                  "    pm.expect(pm.response.json().message).to.include('Unsupported templateName');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealNumber\": \"{{dealNum}}\",\n  \"templateName\": \"DOES_NOT_EXIST\",\n  \"assigneeUserId\": \"{{assigneeUserId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sendEmail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sendEmail"
              ]
            },
            "description": "NotificationBO throws MailException('Unsupported templateName: ...'); MailException without an explicit status maps to 500."
          },
          "response": []
        },
        {
          "name": "Wrong HTTP method on /sendEmail (405)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 405', function () {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sendEmail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sendEmail"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Unknown endpoint (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 (or 401 when unauthenticated)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([404, 401]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "does-not-exist"
              ]
            }
          },
          "response": []
        },
        {
          "name": "No token on protected endpoint (401, non-local only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The local profile is permit-all, so this request only returns 401 on train/prod.",
                  "if (pm.environment.get('envName') === 'local') {",
                  "    pm.test('Skipped on local (permit-all)', function () { pm.expect(true).to.be.true; });",
                  "} else {",
                  "    pm.test('Status is 401', function () {",
                  "        pm.response.to.have.status(401);",
                  "    });",
                  "    pm.test('Body explains authentication failure', function () {",
                  "        pm.expect(pm.response.text()).to.include('Authentication failed');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealNumber\": \"{{dealNum}}\",\n  \"templateName\": \"UW_AUTHORITY_SELF_DECLARATION\",\n  \"assigneeUserId\": \"{{assigneeUserId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/sendEmail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sendEmail"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 API Documentation",
      "item": [
        {
          "name": "OpenAPI JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Documents the sendEmail path', function () {",
                  "    pm.expect(pm.response.json().paths).to.have.property('/api/sendEmail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            },
            "description": "Public springdoc OpenAPI document. Can be imported into Postman as an alternative source of truth."
          },
          "response": []
        },
        {
          "name": "Swagger UI",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger-ui.html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger-ui.html"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    }
  ]
}
