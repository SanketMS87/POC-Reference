<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>mail</groupId>
	<artifactId>mail</artifactId>
	<version>0.3.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>connect</name>
	<description>Mail Application</description>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath />
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>17</java.version>
		<maven.test.skip>false</maven.test.skip>
		<!-- Baseline: Java 17, Spring Boot 3.5.14 (Spring Framework 6.2, Spring Security 6.5, Hibernate 6.6, Tomcat 10.1), embedded Tomcat -->
		<!-- CVE fix: logback-core CVE-2026-13006 — logback pinned to 1.5.38 (Boot 3.5.14 BOM manages 1.5.32) -->
		<logback.version>1.5.38</logback.version>
		<!-- CVE fix: jackson-databind CVE-2026-54512/54513 (CVSS 9.3) — Boot 3.5.14 BOM manages Jackson 2.21.2 (vulnerable);
		     whole Jackson BOM pinned to 2.22.2 so all Jackson modules stay aligned. -->
		<jackson-bom.version>2.22.2</jackson-bom.version>
		<!-- PostgreSQL JDBC driver (Boot BOM manages the version; pinned to the 42.7.x line explicitly) -->
		<postgresql.version>42.7.14</postgresql.version>
		<!-- Spring Cloud Azure 5.x supports Spring Boot 3.5.x (5.23.0 and later) -->
		<spring-cloud-azure.version>5.25.0</spring-cloud-azure.version>
		<!-- Heap for the FORKED test JVM (separate from the Maven-process heap in .mvn/jvm.config) -->
		<test.jvm.maxHeap>1g</test.jvm.maxHeap>
		<!--
		  Empty default for @{argLine} used in maven-surefire-plugin.
		  JaCoCo prepare-agent overwrites this at runtime with the -javaagent string.
		  Without this default, @{argLine} is UNDEFINED when JaCoCo does not run;
		  Java 9+ then interprets the literal "@{argLine}" as an @argfile reference,
		  reads a non-existent file, and falls back to "#" as the main-class name →
		  "Error: Could not find or load main class #".
		-->
		<argLine/>
	</properties>

