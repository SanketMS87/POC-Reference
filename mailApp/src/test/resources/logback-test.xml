<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration for the test classpath.
  Replaces logback-spring.xml during test execution so the logstash appender
  (which requires a live logging.url property) is never activated in unit / integration tests.
-->
<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%5p [%t] %c{1}: %m%n</pattern>
        </encoder>
    </appender>
    <!-- These loggers log expected errors from negative-path tests; silence them to keep the build output readable. -->
    <logger name="com.rukamini.mail.exception.GlobalExceptionHandler" level="OFF"/>
    <logger name="com.rukamini.mail.oauth.Oauth2TokenService" level="OFF"/>
    <logger name="com.rukamini.mail.integration.RestService" level="OFF"/>
    <logger name="com.rukamini.mail.user.GraphUserDirectoryAdapter" level="OFF"/>
    <root level="WARN">
        <appender-ref ref="console"/>
    </root>
</configuration>

